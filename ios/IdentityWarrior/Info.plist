	<key>com.apple.developer.nfc.readersession.iso7816.select-identifiers</key>
	<array>
		<string>A0000002471001</string>
		<string>A0000002472001</string>
		<string>00000000000000</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Identity Warrior uses the camera to capture biometrics</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Allow $(PRODUCT_NAME) to access your Face ID biometric data.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Identity Warrior requires access to your local network to connect to devices over Wi-Fi for seamless functionality.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Identity Warrior requires access to your location while it is in use to provide location-based features.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Identity Warrior uses the microphone to record voice samples during a collection.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Identity Warrior needs access to your photos to upload images for face compare.</string>
