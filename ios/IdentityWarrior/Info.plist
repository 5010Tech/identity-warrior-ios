	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>identitywarrior</string>
				<string>com.fiftyten.identitywarrior</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>exp+identity-warrior</string>
			</array>
		</dict>
	</array>
