  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "eas:dev": "eas build --profile development --platform ios --local && mkdir -p builds builds/dev && mv build-*.ipa ./builds/dev/",
    "eas:preview": "eas build --profile preview --platform ios --local && mkdir -p builds builds/preview && mv build-*.ipa ./builds/preview/",
    "eas:production": "eas build --profile production --platform ios --local && mkdir -p builds builds/production && mv build-*.ipa ./builds/production/",
    "android": "expo run:android",
    "ios": "expo run:ios --device",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "eslint .",
    "postinstall": "patch-package"
  },
